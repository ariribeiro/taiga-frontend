# Endereço INTERNO da API (back): em produção, o Service do OpenShift (ex.: http://taiga-dev-view-back:8080).
API_URL=http://localhost:8080
# Chave compartilhada com a API (INTERNAL_API_KEY lá). Gere com: openssl rand -hex 32
# API_KEY=

# ---- Opcionais (valores abaixo são os padrões) ----
# Quantos proxies confiáveis existem entre o cliente e o front (o roteador do OpenShift conta 1). O IP real do cliente é
# lido do FIM do X-Forwarded-For, pulando estes proxies, e repassado à API para o freio de força bruta do login.
# TRUSTED_PROXY_HOPS=1
# Tempo máximo (ms) de cada chamada à API.
# API_TIMEOUT_MS=45000
